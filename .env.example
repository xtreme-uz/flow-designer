# The flows repository Flow Designer writes to. May be empty: the first save
# creates GIT_DEFAULT_BRANCH on it, with the THUB files under it.
GIT_REMOTE_URL=https://github.com/xtreme-uz/flow-config.git
GIT_DEFAULT_BRANCH=main

# Service account used for clone, pull and push
GIT_USERNAME=
GIT_TOKEN=

# Push as the signed-in user instead. Needs a scope granting repository write
# access (GitLab: write_repository, GitHub: repo) and a remote hosted by
# AUTH_PROVIDER below.
GIT_USE_USER_CREDENTIALS=false

# Which Git host people sign in through: gitlab or github
AUTH_PROVIDER=github

# GITHUB_BASE_URL=https://github.example.com   # GitHub Enterprise Server
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=https://flowdesigner.example.com/login/oauth2/code/github

# GITLAB_BASE_URL=https://gitlab.example.com   # self-hosted GitLab
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITLAB_REDIRECT_URL=https://flowdesigner.example.com/login/oauth2/code/gitlab

# Who may sign in. Both empty means every account the provider authenticates.
AUTH_ALLOWED_USERNAMES=
AUTH_ALLOWED_EMAIL_DOMAINS=
